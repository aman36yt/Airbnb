<% layout("./layouts/boilerplate.ejs") %>
<body>
    <div class="row offset-3 mt-4">
        <h3>Listing Details </h3>
    </div>
    <div class="card col-6 offset-3">
        <img src="<%= listing.img %>" class="card-img-top show-img" alt="Listing_image">
        <div class="card-body">
            <p class="card-text">
                <b><%= listing.title %></b><br>
                <span>
                    <%= listing.description %> <br>
                    Price :₹<%= listing.price.toLocaleString("en-IN") %> <br>
                    Location :<%= listing.location %> <br>
                    Country :<%= listing.country %>
                </span>
            </p>
        </div>
    </div>
    
    <div class="btns mb-4">
        <a class="btn btn-dark col-1 offset-3" href="/listings/<%= listing._id %>/edit">EDIT</a>
        
        <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
            <button class="btn btn-danger  offset-5">DELETE</button>
        </form>
    </div>
    
</body> 