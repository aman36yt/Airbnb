<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NUVORA</title>
</head>
<body>
    <h1>LIST YOUR FLAT HERE :</h1>
    <form action="/listings" method="post">
        <label for="title">TITLE :</label>
         <input type="text" name="listing[title]" id="title" placeholder="ENTER FLAT TITLE" required>
         <br>
         <label for="description">DESCRIPTION :</label><br>
         <textarea name="listing[description]" id="description" required>
            ENTER DETAILS/ DESCRIPTION..
         </textarea><br>
         <label for="img">IMG link :</label>
         <input type="text" name="listing[img]" id="img" placeholder="Paste YOur Link here">
         <label for="price">PRICE :</label>
         <input type="number" name="listing[price]" id="price" placeholder="ENTER your Price" required>
         <br>
         <label for="location">LOCATION :</label>
         <input type="text" name="listing[location]" id="location" placeholder="ENTER YOUR LOCATION" required><br>
         <label for="country">COUNTRY :</label>
         <input type="text" name="listing[country]" id="country" placeholder="ENTER YOUR COUNTRY" required>
         <button>ADD!</button>
    </form>
</body>
</html>