<% layout("./layouts/boilerplate.ejs") %>
<body>
    <h2>All Listings :</h2>
    <div class="container">
        <% for(let Listing of allListings){ %>
        <div class="card" style="width: 20rem;">
            <a href="listings/<%= Listing._id %>"><img src="<%= Listing.img %>" class="card-img-top" alt="Listing_img"></a>
            <div class="card-body">
                <p class="card-text">
                    <a class="list-group-item list-group-item-action" href="listings/<%= Listing._id %>"><%= Listing.title %></a>
                    ₹<%= Listing.price.toLocaleString("en-IN") %>
                </p>
                
            </div>
        </div>
        <% } %>
    </div>
</body>